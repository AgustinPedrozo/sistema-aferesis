<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtViolaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textColor="#E65100"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Solo se puede registrar con la autorización de la Jefa de Área/Gerente y queda constancia del motivo."
            android:textSize="16sp" />

        <EditText
            android:id="@+id/edtMotivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Motivo de la excepción (mín. 10 letras)"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="1000"
            android:minLines="3"
            android:textSize="18sp" />

        <LinearLayout
            android:id="@+id/contAutoriza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Usuario y clave de la Jefa de Área/Gerente"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtUsuarioAut"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Usuario"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions"
                android:maxLength="20"
                android:minHeight="56dp"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/edtClaveAut"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Clave"
                android:importantForAutofill="no"
                android:inputType="numberPassword"
                android:maxLength="10"
                android:minHeight="56dp"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtErrorDialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#B00020"
            android:textSize="16sp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>